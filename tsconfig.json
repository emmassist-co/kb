{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "ignoreDeprecations": "5.0",
    "baseUrl": ".",
    "forceConsistentCasingInFileNames": true,
    "declaration": false,
    "outDir": "dist-ts",
    "rootDir": ".",
    "paths": {
      "@emmassist-co/kb-core": ["packages/kb-core/src/index.ts"],
      "@emmassist-co/kb-core/documents": ["packages/kb-core/src/documents.ts"],
      "@emmassist-co/kb-core/types": ["packages/kb-core/src/types.ts"],
      "@emmassist-co/kb-core/bm25": ["packages/kb-core/src/bm25.ts"],
      "@emmassist-co/kb-core/relations": ["packages/kb-core/src/relations.ts"],
      "@emmassist-co/kb-core/service": ["packages/kb-core/src/service.ts"],
      "@emmassist-co/kb-core/service-helpers": ["packages/kb-core/src/service-helpers.ts"],
      "@emmassist-co/kb-core/store": ["packages/kb-core/src/store.ts"],
      "@emmassist-co/kb-core/snapshot-store": ["packages/kb-core/src/snapshot-store.ts"],
      "@emmassist-co/kb-core/*": ["packages/kb-core/src/*"],
      "@emmassist-co/kb-storage-file": ["packages/kb-storage-file/src/index.ts"],
      "@emmassist-co/kb-storage-file/*": ["packages/kb-storage-file/src/*"],
      "@emmassist-co/kb-storage-cloudflare": ["packages/kb-storage-cloudflare/src/index.ts"],
      "@emmassist-co/kb-storage-cloudflare/*": ["packages/kb-storage-cloudflare/src/*"],
      "@emmassist-co/kb-http": ["packages/kb-http/src/index.ts"],
      "@emmassist-co/kb-http/auth": ["packages/kb-http/src/auth.ts"],
      "@emmassist-co/kb-http/route-auth": ["packages/kb-http/src/route-auth.ts"],
      "@emmassist-co/kb-http/types": ["packages/kb-http/src/types.ts"],
      "@emmassist-co/kb-http/*": ["packages/kb-http/src/*"],
      "@emmassist-co/kb-mcp": ["packages/kb-mcp/src/index.ts"],
      "@emmassist-co/kb-mcp/*": ["packages/kb-mcp/src/*"],
      "@emmassist-co/kb-cli": ["packages/kb-cli/src/index.ts"],
      "@emmassist-co/kb-cli/*": ["packages/kb-cli/src/*"],
      "@emmassist-co/kb-flue-adapter": ["packages/kb-flue-adapter/src/index.ts"],
      "@emmassist-co/kb-flue-adapter/*": ["packages/kb-flue-adapter/src/*"],
      "@emmassist-co/kb-autoresearch": ["packages/kb-autoresearch/src/index.ts"],
      "@emmassist-co/kb-autoresearch/*": ["packages/kb-autoresearch/src/*"]
    }
  },
  "include": [
    "packages/kb-core/src/**/*.ts",
    "packages/kb-storage-file/src/**/*.ts",
    "packages/kb-http/src/**/*.ts",
    "packages/kb-mcp/src/**/*.ts",
    "packages/kb-cli/src/**/*.ts",
    "packages/kb-flue-adapter/src/**/*.ts",
    "packages/kb-autoresearch/src/**/*.ts"
  ],
  "exclude": [
    "packages/kb-storage-cloudflare/**",
    "scripts/**",
    "tests/**",
    "eval/**"
  ]
}
