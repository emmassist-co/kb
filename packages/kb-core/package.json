{
  "name": "@emmassist-co/kb-core",
  "version": "0.6.1",
  "private": false,
  "description": "Backend-neutral knowledge base semantics for the Cloudflare-first KB stack.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emmassist-co/kb.git",
    "directory": "packages/kb-core"
  },
  "homepage": "https://github.com/emmassist-co/kb/tree/main/packages/kb-core#readme",
  "bugs": {
    "url": "https://github.com/emmassist-co/kb/issues"
  },
  "keywords": [
    "knowledge-base",
    "cloudflare",
    "r2",
    "agents"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "dependencies": {
    "yaml": "^2.8.1"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    },
    "./documents": {
      "types": "./dist/documents.d.ts",
      "default": "./dist/documents.js"
    },
    "./bm25": {
      "types": "./dist/bm25.d.ts",
      "default": "./dist/bm25.js"
    },
    "./relations": {
      "types": "./dist/relations.d.ts",
      "default": "./dist/relations.js"
    },
    "./service": {
      "types": "./dist/service.d.ts",
      "default": "./dist/service.js"
    },
    "./service-helpers": {
      "types": "./dist/service-helpers.d.ts",
      "default": "./dist/service-helpers.js"
    },
    "./store": {
      "types": "./dist/store.d.ts",
      "default": "./dist/store.js"
    },
    "./snapshot-store": {
      "types": "./dist/snapshot-store.d.ts",
      "default": "./dist/snapshot-store.js"
    }
  }
}
