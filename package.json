{
  "name": "@emmassist-co/kb-monorepo",
  "version": "1.3.0",
  "private": true,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emmassist-co/kb.git"
  },
  "homepage": "https://github.com/emmassist-co/kb#readme",
  "bugs": {
    "url": "https://github.com/emmassist-co/kb/issues"
  },
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "clean": "rm -rf packages/kb-core/dist packages/kb-storage-file/dist packages/kb-storage-cloudflare/dist packages/kb-http/dist packages/kb-mcp/dist packages/kb-dashboard/dist packages/kb-cli/dist packages/kb-flue-adapter/dist",
    "build:kb-core": "tsc -p packages/kb-core/tsconfig.json",
    "build:kb-storage-file": "tsc -p packages/kb-storage-file/tsconfig.json",
    "build:kb-storage-cloudflare": "tsc -p packages/kb-storage-cloudflare/tsconfig.json",
    "build:kb-http": "tsc -p packages/kb-http/tsconfig.json",
    "build:kb-mcp": "npm run build:kb-http && tsc -p packages/kb-mcp/tsconfig.json",
    "build:kb-cli": "tsc -p packages/kb-cli/tsconfig.json",
    "build:public": "npm run clean && npm run build:kb-core && npm run build:kb-storage-file && npm run build:kb-storage-cloudflare && npm run build:kb-http && npm run build:kb-mcp && npm run build:kb-dashboard && npm run build:kb-cli && npm run build:kb-flue-adapter",
    "verify:public-packages": "npm run build:public && node scripts/verify-public-packages.mjs",
    "smoke:kb-agent-readiness": "node --import tsx/esm scripts/kb-agent-readiness-smoke.ts",
    "smoke:kb-mcp": "node --import tsx/esm scripts/kb-mcp-smoke.ts",
    "smoke:codex-mcp": "node --import tsx/esm scripts/kb-codex-mcp-smoke.ts",
    "serve:kb-mcp-stdio": "node --import tsx/esm scripts/kb-mcp-stdio.ts",
    "check:kb:anti-cheat": "node scripts/check-kb-benchmark-shortcuts.mjs && node scripts/audit-relation-template-coupling.mjs",
    "verify:kb:evals": "npm run check:kb:anti-cheat && node --import tsx/esm --test tests/kb-cli-docs.test.ts && npm run eval:kb:all -- --no-write-scorecard && npm run eval:kb:admin-world -- --split dev && npm run eval:kb:admin-world -- --split holdout && npm run eval:kb:relation-paraphrase && npm run eval:kb:relation-transfer && npm run eval:kb:gbrain-evals-upstream && npm run eval:kb:gbrain-world",
    "compile": "npm run build:public",
    "typecheck": "tsc --noEmit",
    "test": "npm run build:public && node scripts/run-node-tests.mjs",
    "test:bench": "node --import tsx/esm --test tests/kb-benchmark.test.ts",
    "eval:kb": "node --import tsx/esm eval/runner/kb-benchmark.ts",
    "eval:kb:all": "node --import tsx/esm eval/runner/kb-eval.ts",
    "eval:kb:admin-world": "node --import tsx/esm eval/runner/kb-benchmark.ts --admin-world eval/data/admin-world-v3",
    "eval:kb:admin-world:refresh": "node scripts/expand-admin-world-v3.mjs",
    "eval:kb:cat": "node --import tsx/esm eval/runner/kb-eval.ts",
    "eval:kb:repo-docs": "node --import tsx/esm eval/runner/kb-benchmark.ts --repo-docs eval/data/repo-docs-v1",
    "eval:kb:relation-paraphrase": "node --import tsx/esm eval/runner/kb-benchmark.ts --relation-paraphrase eval/data/relation-paraphrase-v1",
    "eval:kb:relation-transfer": "node --import tsx/esm eval/runner/kb-benchmark.ts --relation-transfer eval/data/relation-transfer-v1",
    "eval:kb:gbrain-world": "node --import tsx/esm eval/runner/kb-benchmark.ts --gbrain-world eval/data/gbrain-world-v1 --gbrain-world-contract github-benchmark --side-by-side",
    "eval:kb:gbrain-evals-upstream": "node --import tsx/esm scripts/run-gbrain-evals-upstream.ts",
    "eval:kb:gbrain-evals-upstream:kb": "node --import tsx/esm scripts/run-gbrain-evals-upstream.ts --adapter=kb-upstream",
    "eval:kb:gbrain-world-corpus-links": "node --import tsx/esm eval/runner/kb-benchmark.ts --gbrain-world eval/data/gbrain-world-v1 --gbrain-world-contract corpus-linkable --side-by-side",
    "build:kb-flue-adapter": "tsc -p packages/kb-flue-adapter/tsconfig.json",
    "build:kb-dashboard": "tsc -p packages/kb-dashboard/tsconfig.json && vite build --config packages/kb-dashboard/dashboard/vite.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.908.0",
    "@flue/sdk": "^0.3.10",
    "just-bash": "^2.14.4",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "@types/node": "^24.8.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "wrangler": "^4.87.0"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "4.62.2"
  }
}
